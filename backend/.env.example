# ---- Required ----

# Groq (LLM inference). Get a key at https://console.groq.com/keys
# Never commit your real key. This file is a template only.
GROQ_API_KEY=

# Pinecone (vector database + hosted embeddings/reranking).
# Get a key at https://app.pinecone.io/organizations/-/keys
PINECONE_API_KEY=

# ---- Optional but recommended ----

# A GitHub personal access token (no scopes needed for public repos) raises the
# GitHub API rate limit from 60/hr to 5,000/hr and is required for private repos
# and for deeper commit-history analysis. Create one at
# https://github.com/settings/tokens
GITHUB_TOKEN=

# ---- Model / index configuration (sensible defaults, override if you like) ----

# Primary chat/reasoning model used for chat, architecture summaries, bug
# review and documentation generation.
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Faster/cheaper model used for lightweight, high-volume tasks.
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Pinecone index name. Created automatically on first run if it doesn't exist.
PINECONE_INDEX_NAME=codebase-chat
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Pinecone-hosted embedding + reranking models (integrated inference, no
# separate embedding API/key needed).
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_RERANK_MODEL=bge-reranker-v2-m3

# ---- App configuration ----

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where extracted repo files + generated docs are cached on disk.
DATA_DIR=./data

# Safety caps so a huge repo can't blow up indexing time/cost.
MAX_FILES_PER_REPO=1200
MAX_FILE_SIZE_BYTES=300000
