# The frontend talks to the backend through Vite's dev-server proxy (see
# vite.config.js), so no VITE_API_BASE_URL is needed for local development.
# This only matters if you're pointing the dev server at a backend that
# isn't running on http://127.0.0.1:8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
